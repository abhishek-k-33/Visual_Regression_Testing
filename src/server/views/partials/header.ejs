<%#
  Shared page head + navbar.
  Params: title, crumbs (array of { label, href?, mono? }; the last one is the current page),
  navLink ('back' for "Back to Runs", otherwise "Documentation"),
  repoUrl (optional; static demo banner links to it).
  All local URLs go through url() so pages work under a sub-path.
  mode === 'static' (the GitHub Pages build) adds a banner explaining that approvals are simulated.
-%>
<% const pageCrumbs = locals.crumbs || []; -%>
<!DOCTYPE html>
<html lang="en" data-base="<%= base %>" data-mode="<%= mode %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.title || 'Visual Regression Tool' %></title>
<%# Theme: runs before the stylesheet so the first paint already has the right colours.
    Stored choice ('vrt-theme' in localStorage) wins, otherwise the system preference.
    No JS = no data-theme = the dark default. public/js/theme.js does the rest. -%>
  <script>(function () { var t; try { t = localStorage.getItem('vrt-theme'); } catch (e) {} if (t !== 'light' && t !== 'dark') { t = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'; } document.documentElement.setAttribute('data-theme', t); })();</script>
  <link rel="stylesheet" href="<%= url('/css/styles.css') %>">
</head>
<body>
  <!-- Header: Compact top navbar with breadcrumbs -->
  <header class="navbar">
    <div class="navbar-inner">
      <div class="navbar-left">
        <a href="<%= url('/') %>" class="navbar-brand">
          <div class="navbar-brand-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <circle cx="8.5" cy="8.5" r="1.5"></circle>
              <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
          </div>
          <span>Visual CI</span>
        </a>
        <% pageCrumbs.forEach((crumb, i) => { const middle = i < pageCrumbs.length - 1 ? ' crumb-middle' : ''; -%>
        <span class="breadcrumb-separator<%= middle %>">/</span>
        <% if (crumb.href) { -%>
        <a href="<%= url(crumb.href) %>" class="navbar-link<%= middle %>" style="padding: 0; font-size: 14px;"><%= crumb.label %></a>
        <% } else if (crumb.mono) { -%>
        <span class="breadcrumb-current<%= middle %>" style="font-family: var(--font-mono); font-size: 13px;"><%= crumb.label %></span>
        <% } else { -%>
        <span class="breadcrumb-current<%= middle %>"><%= crumb.label %></span>
        <% } -%>
        <% }) -%>
      </div>

      <div class="navbar-right">
<%# Two-state toggle: aria-pressed="true" = dark theme on (synced by theme.js; hidden without JS). -%>
        <button type="button" class="theme-toggle" data-theme-toggle aria-pressed="true" title="Toggle dark theme">
          <svg class="theme-icon theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <svg class="theme-icon theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
          </svg>
          <span class="visually-hidden">Dark theme</span>
        </button>
        <% if (locals.navLink === 'back') { -%>
        <a href="<%= url('/') %>" class="navbar-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span class="navbar-link-text">Back to Runs</span>
        </a>
        <% } else { -%>
        <a href="<%= url('/') %>" class="navbar-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
          </svg>
          <span class="navbar-link-text">Documentation</span>
        </a>
        <% } -%>
      </div>
    </div>
  </header>
<% if (mode === 'static') { -%>
  <div class="demo-banner" role="note" aria-label="About this demo">
    <div class="demo-banner-inner">
      <span class="demo-banner-tag">Demo</span>
      <p class="demo-banner-text">
        Live demo with sample data: approvals are simulated and reset when you reload. Run it locally to review your own app.
        <%_ if (locals.repoUrl) { _%>
        <a href="<%= repoUrl %>" class="demo-banner-link">Get it on GitHub</a>
        <%_ } _%>
      </p>
    </div>
  </div>
<% } -%>
