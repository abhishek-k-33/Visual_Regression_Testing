<%- include('partials/header', { navLink: 'back', crumbs: [{ label: 'Dashboard', href: '/' }, { label: run.id, mono: true }] }) %>

  <!-- Main Container -->
  <main class="container">
    <!-- Run Summary Header Card -->
    <div class="detail-header-card">
      <div class="detail-title-row">
        <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
          <h1 class="detail-run-id"><%= run.id %></h1>
          <% if (run.status === 'PASSED') { %>
            <span class="status-pill status-pill-passed">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>PASSED</span>
            </span>
          <% } else if (run.status === 'APPROVED') { %>
            <span class="status-pill status-pill-approved">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              <span>APPROVED</span>
            </span>
          <% } else if (run.status === 'FAILED') { %>
            <span class="status-pill status-pill-failed">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
              <span>FAILED</span>
            </span>
          <% } else if (run.status === 'REJECTED') { %>
            <span class="status-pill status-pill-rejected">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
              </svg>
              <span>REJECTED</span>
            </span>
          <% } %>
        </div>
      </div>

      <div class="detail-meta-row">
        <% if (run.branch) { %>
          <span class="git-badge">
            <svg class="git-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="6" y1="3" x2="6" y2="15"></line>
              <circle cx="18" cy="6" r="3"></circle>
              <circle cx="6" cy="18" r="3"></circle>
              <path d="M18 9a9 9 0 0 1-9 9"></path>
            </svg>
            <span><%= run.branch %></span>
          </span>
        <% } %>
        <% if (run.commit_hash) { %>
          <span class="git-badge git-commit">#<%= run.commit_hash %></span>
        <% } %>
        <span>• Created on <%= run.created_at %></span>
        <span>• <%= snapshots.length %> total snapshot(s)</span>
      </div>
    </div>

    <!-- Snapshots Inspection List -->
    <% snapshots.forEach(snap => { %>
      <div class="snapshot-card" id="snapshot-<%= snap.id %>">
        <!-- Header: Route, Viewport & Actions -->
        <div class="snapshot-header">
          <div class="snapshot-title">
            <span class="route-pill"><%= snap.route %></span>
            <span class="viewport-badge"><%= snap.viewport %></span>
            <% if (snap.historyUrl) { %>
              <a href="<%= url(snap.historyUrl) %>" class="history-link" aria-label="History of <%= snap.route %> at <%= snap.viewport %>">History</a>
            <% } %>

            <div class="status-badge-container">
              <% if (snap.status === 'MATCH') { %>
                <span class="status-pill status-pill-passed">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>MATCH (0.00%)</span>
                </span>
              <% } else if (snap.status === 'DIFF') { %>
                <span class="status-pill status-pill-failed">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                  <span><%= snap.mismatch_percentage.toFixed(2) %>% Mismatch</span>
                </span>
              <% } else if (snap.status === 'MISSING_BASELINE') { %>
                <span class="status-pill status-pill-failed">
                  <span>MISSING BASELINE</span>
                </span>
              <% } else if (snap.status === 'NEW_BASELINE') { %>
                <span class="status-pill status-pill-new">
                  <span>NEW BASELINE</span>
                </span>
              <% } else if (snap.status === 'APPROVED') { %>
                <span class="status-pill status-pill-approved">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>APPROVED</span>
                </span>
              <% } else if (snap.status === 'REJECTED') { %>
                <span class="status-pill status-pill-rejected">
                  <span>REJECTED</span>
                </span>
              <% } %>
            </div>
          </div>

          <div class="snapshot-actions">
            <% if (snap.status === 'DIFF' || snap.status === 'MISSING_BASELINE') { %>
              <button class="btn btn-approve" data-id="<%= snap.id %>">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Approve & Update Baseline</span>
              </button>
              <button class="btn btn-reject" data-id="<%= snap.id %>">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
                <span>Reject</span>
              </button>
            <% } else if (snap.status === 'APPROVED') { %>
              <span style="font-size: 13px; color: var(--success-green); font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Baseline Promoted</span>
              </span>
            <% } %>
          </div>
        </div>

        <!-- 3 Interactive Tabs -->
        <nav class="tabs-nav">
          <button class="tab-btn active" data-tab="side-by-side">Side-by-Side</button>
          <% if (snap.baselineUrl) { %>
            <button class="tab-btn" data-tab="slider">Interactive Slider</button>
          <% } %>
          <% if (snap.diffUrl) { %>
            <button class="tab-btn" data-tab="diff">Diff Highlight</button>
          <% } %>
        </nav>

        <!-- Tab 1: Side-by-Side View -->
        <div class="tab-panel active" data-panel="side-by-side">
          <div class="side-by-side">
            <div class="image-preview-container">
              <div class="image-preview-label">Approved Baseline</div>
              <div class="image-frame">
                <% if (snap.baselineUrl) { %>
                  <img src="<%= url(snap.baselineUrl) %>" alt="Baseline screenshot">
                <% } else { %>
                  <div style="padding: 48px; text-align: center; color: var(--text-muted); font-size: 13px;">
                    <% if (snap.status === 'MISSING_BASELINE') { %>
                      No baseline exists for this route. Approving will make the current screenshot its baseline.
                    <% } else { %>
                      No prior baseline existed for this route. Current screenshot was promoted as initial golden master.
                    <% } %>
                  </div>
                <% } %>
              </div>
            </div>

            <div class="image-preview-container">
              <div class="image-preview-label">Current Test Execution</div>
              <div class="image-frame">
                <% if (snap.currentUrl) { %>
                  <img src="<%= url(snap.currentUrl) %>" alt="Current screenshot">
                <% } else { %>
                  <div style="padding: 48px; text-align: center; color: var(--text-muted); font-size: 13px;">
                    Screenshot is not in this dashboard's storage folder.
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <!-- Tab 2: Interactive Draggable Slider View -->
        <% if (snap.baselineUrl) { %>
          <div class="tab-panel" data-panel="slider">
            <div style="margin-bottom: 14px; font-size: 13px; color: var(--text-secondary); text-align: center;">
              ⇄ Drag the vertical line left and right to inspect visual changes
            </div>
            <div class="slider-view-container">
              <div class="slider-wrapper">
                <!-- Under Image (Baseline) -->
                <img src="<%= url(snap.baselineUrl) %>" class="slider-img-under" alt="Baseline image">

                <!-- Over Image (Current) with responsive clipping -->
                <div class="slider-img-over-wrapper">
                  <img src="<%= url(snap.currentUrl) %>" class="slider-img-over" alt="Current image">
                </div>

                <!-- Draggable vertical divider -->
                <div class="slider-divider">
                  <div class="slider-handle-pill">⇄</div>
                </div>
              </div>
            </div>
          </div>
        <% } %>

        <!-- Tab 3: Diff Highlight View -->
        <% if (snap.diffUrl) { %>
          <div class="tab-panel" data-panel="diff">
            <div style="margin-bottom: 14px; font-size: 13px; color: var(--error-red); font-weight: 600; text-align: center;">
              Diff Highlight: Differing pixels are highlighted in bright neon red (<%= snap.mismatch_percentage.toFixed(2) %>% mismatch)
            </div>
            <div class="image-frame" style="max-width: 1200px; margin: 0 auto;">
              <img src="<%= url(snap.diffUrl) %>" alt="Diff image">
            </div>
          </div>
        <% } %>
      </div>
    <% }) %>
  </main>

<%- include('partials/footer', { scripts: ['/js/tabs.js', '/js/slider.js', '/js/review-actions.js'] }) %>
