<%# Error page. Params: title, heading, message (both escaped here). -%>
<%- include('partials/header', { navLink: 'back', crumbs: [{ label: 'Dashboard', href: '/' }, { label: locals.title || 'Error' }] }) %>

  <main class="container" id="main" tabindex="-1">
    <div class="error-container">
      <h1><%= locals.heading || 'Something went wrong' %></h1>
      <p><%= locals.message || '' %></p>
    </div>
  </main>

<%- include('partials/footer') %>
