{
  "name": "visual-ci",
  "version": "1.0.0",
  "description": "Self-hosted visual regression testing for CI: Playwright screenshots, pixel diffs, a review dashboard and a GitHub Action",
  "keywords": [
    "visual-regression",
    "visual-testing",
    "screenshot-testing",
    "regression-testing",
    "playwright",
    "pixelmatch",
    "screenshot",
    "ci",
    "github-actions",
    "cli",
    "dashboard"
  ],
  "homepage": "https://github.com/abhishek-k-33/Visual_Regression_Testing#readme",
  "bugs": {
    "url": "https://github.com/abhishek-k-33/Visual_Regression_Testing/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhishek-k-33/Visual_Regression_Testing.git"
  },
  "license": "MIT",
  "author": "",
  "type": "module",
  "bin": {
    "visual-ci": "./src/cli/index.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server/app.js",
    "server": "node src/server/app.js",
    "capture": "node src/cli/index.js capture",
    "test:visual": "node src/cli/index.js test",
    "demo": "node scripts/demo.js",
    "demo:serve": "node scripts/serve-demo.js",
    "demo:pages": "node scripts/build-static-demo.js --out _site --base /Visual_Regression_Testing",
    "docker:build": "docker compose build",
    "docker:dashboard": "docker compose up dashboard",
    "docker:test": "docker compose run --rm runner",
    "docker:update-baselines": "docker compose run --rm runner node src/cli/index.js test --update-baselines",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "commander": "^13.1.0",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "pixelmatch": "^7.1.0",
    "playwright": "1.64.1",
    "pngjs": "^7.0.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "vitest": "^3.0.7",
    "yaml": "^2.9.1"
  }
}
